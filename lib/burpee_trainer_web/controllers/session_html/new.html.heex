<Layouts.app flash={@flash} current_scope={nil}>
  <main id="login-page" class="mx-auto w-full max-w-3xl">
    <div class="adaptive-home">
      <section class="login">
        <h1 id="login-heading" class="screen-heading">BurpeeTrainer</h1>
        <p class="login-note">Sign in to see today's workout.</p>
        <a href={~p"/auth/oidc"} class="home-primary-action login-action">
          Sign in with Pocket ID
        </a>
      </section>
    </div>
  </main>
</Layouts.app>
